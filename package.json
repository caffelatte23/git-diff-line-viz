{
  "name": "git-diff-line-viz",
  "displayName": "Git Diff Line Viz",
  "version": "0.0.3",
  "description": "Show +/- line diff between a target branch and the current branch in the status bar.",
  "categories": [
    "Other"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/caffelatte23/git-diff-line-viz.git"
  },
  "publisher": "CaffeLatte23",
  "main": "./out/extension.js",
  "scripts": {
    "build": "bun build src/extension.ts --target=node --format=cjs --outfile=out/extension.js --external vscode",
    "watch": "bun build src/extension.ts --target=node --format=cjs --outfile=out/extension.js --external vscode --watch",
    "test": "bun test ./test",
    "test:e2e": "bun test ./e2e",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "oxlint",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "package": "bunx @vscode/vsce package --no-dependencies",
    "icon:png": "bunx sharp-cli -i logo.svg -o images/icon.png resize 128 128",
    "prepare": "lefthook install",
    "vscode:prepublish": "bun run build"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^20",
    "@types/vscode": "^1.75.0",
    "lefthook": "^2.1.12",
    "oxfmt": "^0",
    "oxlint": "^1",
    "typescript": "^5"
  },
  "contributes": {
    "commands": [
      {
        "command": "gitDiffLineViz.pickBranch",
        "title": "Git Diff Line Viz: Pick Target Branch"
      }
    ],
    "configuration": {
      "title": "Git Diff Line Viz",
      "properties": {
        "gitDiffLineViz.targetBranch": {
          "type": "string",
          "default": "HEAD",
          "description": "What to compare the current branch against (merge-base). A branch name (e.g. \"main\"), or \"HEAD\" for the current branch tip (shows only uncommitted work). Empty = \"HEAD\"."
        },
        "gitDiffLineViz.includeWorkingTree": {
          "type": "boolean",
          "default": true,
          "description": "Include uncommitted (staged + unstaged) changes in the line count."
        }
      }
    }
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "icon": "images/icon.png",
  "engines": {
    "vscode": "^1.75.0"
  }
}
